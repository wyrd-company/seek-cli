{
	"name": "Seek CLI",
	"image": "mcr.microsoft.com/devcontainers/base:noble",

	"features": {
        "ghcr.io/devcontainers-extra/features/bun:1": {}
    },

	"customizations": {
        "vscode": {
            "extensions": [
                "fill-labs.dependi",
                "github.vscode-github-actions"
            ]
        }
    },
	"containerEnv": {
		"DEVCONTAINER_ID": "${devcontainerId}",
		"WORKSPACE_HOME": "${containerWorkspaceFolder}"
	}
}
