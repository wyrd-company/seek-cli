# Copy this to .env or export the keys in your shell before running live tests.
# Live tests are opt-in:
#   RUN_LIVE_TESTS=1 bun test tests/live
# Long-running research smoke tests are separately opt-in:
#   RUN_LIVE_TESTS=1 RUN_LONG_LIVE_TESTS=1 bun test tests/live
# Save sanitized live request/response artifacts under .test-artifacts/live:
#   SAVE_LIVE_ARTIFACTS=1 RUN_LIVE_TESTS=1 bun test tests/live

PARALLEL_API_KEY=
EXA_API_KEY=
BRAVE_SEARCH_API_KEY=
BRAVE_ANSWERS_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
FIRECRAWL_API_KEY=
