# Shared settings for seek's recordings. Each tape sources this file first.
Require seek
Set Shell "bash"
Set FontSize 16
Set Width 1280
Set Height 700
Set Theme "Catppuccin Mocha"
Set Padding 20
Set Margin 10
Set MarginFill "#11111b"
Set BorderRadius 8
Set WindowBar "Colorful"
Set TypingSpeed 25ms

Hide
Type 'cd "$SEEK_DOCS_DIR" && export PS1="$ " && unset HISTFILE && clear'
Enter
Show
