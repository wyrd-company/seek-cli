{
  "name": "seek-cli",
  "version": "0.1.1",
  "description": "Agent-friendly CLI for web search, deep research, and scraping across popular APIs.",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "seek": "./bin/seek"
  },
  "scripts": {
    "ci": "./scripts/ci.sh",
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/seek",
    "build:js": "bun build src/index.ts --target=bun --outfile dist/seek.js",
    "publish:homebrew": "./scripts/publish-homebrew-tap.sh",
    "release": "./scripts/release.sh",
    "test": "bun test tests/*.test.ts",
    "test:live": "RUN_LIVE_TESTS=1 bun test tests/live",
    "test:live:long": "RUN_LIVE_TESTS=1 RUN_LONG_LIVE_TESTS=1 bun test tests/live",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.0"
  }
}
